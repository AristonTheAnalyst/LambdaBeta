# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# Xcode 27's iOS SDK only supports deployment targets 15.0+. Podspecs still declare
# older ones (9.0–13.0), which Xcode rejects at build time, so force every target up to
# the app's minimum. Must run AFTER flutter_additional_ios_build_settings, which deletes
# the setting on targets below 13.0.
IOS_DEPLOYMENT_TARGET = '15.0'

# Xcode 26+ enables "explicit modules" for Clang and Swift. Before using a module, the
# build system verifies it standalone, and that verification runs each pod's module with
# only the pod's own framework search paths -- the Flutter engine directories that
# flutter_additional_ios_build_settings adds are not passed. Every plugin pod that does
# `#import <Flutter/Flutter.h>` therefore fails with:
#
#   'Flutter/Flutter.h' file not found -> could not build module '<plugin>'
#   (fatal) could not build module 'Test'
#
# which aborts device builds (Release in particular). With explicit modules off, clang
# resolves the engine framework through FRAMEWORK_SEARCH_PATHS as it always has.
# Remove this once the toolchain passes engine search paths to module verification.
EXPLICIT_MODULES_OFF = {
  'CLANG_ENABLE_EXPLICIT_MODULES' => 'NO',
  'SWIFT_ENABLE_EXPLICIT_MODULES' => 'NO',
}

post_install do |installer|
  installer.pods_project.build_configurations.each do |config|
    config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = IOS_DEPLOYMENT_TARGET
    EXPLICIT_MODULES_OFF.each { |key, value| config.build_settings[key] = value }
  end

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = IOS_DEPLOYMENT_TARGET
      EXPLICIT_MODULES_OFF.each { |key, value| config.build_settings[key] = value }
    end
  end
end
